{
  "name": "99front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webgl": "NEXT_PUBLIC_WEBGL_DEBUG=true next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "deploy:database": "NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
    "deploy:app": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && payload generate:types",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@payloadcms/db-d1-sqlite": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/storage-r2": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "@radix-ui/react-icons": "1.3.2",
    "@vercel/analytics": "1.5.0",
    "clsx": "2.1.1",
    "eslint-config-prettier": "10.1.8",
    "graphql": "16.15.0",
    "gsap": "3.15.1",
    "meshoptimizer": "0.25.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.108.2",
    "three": "0.181.1",
    "tiny-emitter": "2.1.0",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.181.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.7.1",
    "stats-js": "1.0.1",
    "tailwindcss": "4.3.5",
    "three-perf": "1.0.11",
    "tweakpane": "4.0.5",
    "typescript": "5.9.3",
    "typescript-plugin-css-modules": "5.3.0",
    "wrangler": "4.164.0"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
