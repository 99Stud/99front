{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "99front",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "98b7d2e0-0f73-454d-8a11-9cd681ce72c2",
      "database_name": "99front",
      // Lets `payload migrate` and `next build` reach the real database when NODE_ENV=production
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "99front-media",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match "name" above
      "service": "99front",
    },
  ],
}
